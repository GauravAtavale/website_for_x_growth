{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker name — this becomes <name>.<your-subdomain>.workers.dev
	"name": "growth-studio",
	"keep_vars": true,
	// Explicit so deploys don't warn: serve on *.workers.dev and keep preview URLs.
	"workers_dev": true,
	"preview_urls": true,
	// custom-worker.ts wraps the generated .open-next/worker.js (adds the /hf/ model proxy)
	"main": "custom-worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Lets the Worker call itself (used by OpenNext for caching/revalidation)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "growth-studio"
		}
	],
	"d1_databases": [
		{
			"binding": "LEADERBOARD_DB",
			"database_name": "growth-leaderboard",
			"database_id": "261023ea-0479-4c62-8933-c9ce10808073",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true,
		// Issues: groups crashes, 5xx responses and console.error() logs (incl.
		// browser errors sent to /api/client-error) so you can get alerts.
		"issues": {
			"enabled": true
		}
	}
}