# Dependencies (downloaded by npm, never commit)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and caches
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext build output and local secrets
.open-next
.wrangler
.dev.vars*
!.dev.vars.example
cloudflare-env.d.ts

# Environment files (may hold keys)
.env*

# Archives (e.g. the project zip)
*.zip

# OS and editor clutter
.DS_Store
Thumbs.db
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local-only folders from the original project
public/backgrounds
/scripts/*
!/scripts/indexnow.ts